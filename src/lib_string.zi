// String library with Lua patterns, following lstrlib.c of Lua 5.1 and the
// LuaJIT additions Luanti code relies on (string.rep separators, %s using
// __tostring in string.format).

#scope_module

MAX_CAPTURES :: 32;
CAP_UNFINISHED :: -1;
CAP_POSITION :: -2;
MAX_MATCH_DEPTH :: 200;

MatchState :: struct {
    L: *LuaState
    src: string
    pat: string
    level: s32
    depth: s32
    failed: bool
    capture_start: [32]s64
    capture_len: [32]s64
}

MatchFail :: (ms: *MatchState, message: string) -> s64 {
    if !ms.failed {
        ms.failed = true
        LuaErrorText(ms.L, message)
    }
    return -1
}

// Relative string positions: negative counts from the end.
StringPosition :: (position: s64, length: s64) -> s64 #inline {
    if position < 0 { return length + position + 1 }
    return position
}

IsLowerByte :: (c: u8) -> bool #inline { return c >= #char "a" && c <= #char "z" }
IsUpperByte :: (c: u8) -> bool #inline { return c >= #char "A" && c <= #char "Z" }
IsControlByte :: (c: u8) -> bool #inline { return c < 32 || c == 127 }
IsPunctByte :: (c: u8) -> bool #inline { return c > 32 && c < 127 && !IsDigit(c) && !(IsAlpha(c) && c != #char "_") }

ClassMatches :: (c: u8, cl: u8) -> bool {
    lower := cl | 32
    result := false
    if lower == #char "a" { result = IsAlpha(c) && c != #char "_" }
    else if lower == #char "c" { result = IsControlByte(c) }
    else if lower == #char "d" { result = IsDigit(c) }
    else if lower == #char "l" { result = IsLowerByte(c) }
    else if lower == #char "p" { result = IsPunctByte(c) }
    else if lower == #char "s" { result = IsSpace(c) }
    else if lower == #char "u" { result = IsUpperByte(c) }
    else if lower == #char "w" { result = (IsAlpha(c) && c != #char "_") || IsDigit(c) }
    else if lower == #char "x" { result = IsXDigit(c) }
    else if lower == #char "z" { result = c == 0 }
    else { return cl == c }
    if IsUpperByte(cl) { return !result }
    return result
}

// End of the single-character class starting at p.
ClassEnd :: (ms: *MatchState, p: s64) -> s64 {
    pat := ms.pat
    at := p
    c := pat[at]
    at += 1
    if c == #char "%" {
        if at >= pat.count { return MatchFail(ms, "malformed pattern (ends with '%')") }
        return at + 1
    }
    if c == #char "[" {
        if at < pat.count && pat[at] == #char "^" { at += 1 }
        // Look for the closing ']'; the first character may be ']'.
        first := true
        while true {
            if at >= pat.count { return MatchFail(ms, "malformed pattern (missing ']')") }
            cc := pat[at]
            at += 1
            if cc == #char "]" && !first { return at }
            first = false
            if cc == #char "%" {
                if at >= pat.count { return MatchFail(ms, "malformed pattern (missing ']')") }
                at += 1
            }
        }
    }
    return at
}

// c against the set [..] spanning pat[p..ec] (p at '[', ec at ']').
BracketMatches :: (ms: *MatchState, c: u8, p_in: s64, ec: s64) -> bool {
    pat := ms.pat
    p := p_in + 1
    negate := false
    if pat[p] == #char "^" {
        negate = true
        p += 1
    }
    while p < ec {
        if pat[p] == #char "%" && p + 1 < ec {
            p += 1
            if ClassMatches(c, pat[p]) { return !negate }
            p += 1
        } else if p + 2 < ec && pat[p + 1] == #char "-" {
            if pat[p] <= c && c <= pat[p + 2] { return !negate }
            p += 3
        } else {
            if pat[p] == c { return !negate }
            p += 1
        }
    }
    return negate
}

SingleMatch :: (ms: *MatchState, s: s64, p: s64, ep: s64) -> bool {
    if s >= ms.src.count { return false }
    c := ms.src[s]
    pc := ms.pat[p]
    if pc == #char "." { return true }
    if pc == #char "%" { return ClassMatches(c, ms.pat[p + 1]) }
    if pc == #char "[" { return BracketMatches(ms, c, p, ep - 1) }
    return pc == c
}

MatchBalance :: (ms: *MatchState, s: s64, p: s64) -> s64 {
    if p + 1 >= ms.pat.count { return MatchFail(ms, "unbalanced pattern") }
    if s >= ms.src.count || ms.src[s] != ms.pat[p] { return -1 }
    open := ms.pat[p]
    close := ms.pat[p + 1]
    depth: s64 = 1
    at := s + 1
    while at < ms.src.count {
        c := ms.src[at]
        if c == close {
            depth -= 1
            if depth == 0 { return at + 1 }
        } else if c == open {
            depth += 1
        }
        at += 1
    }
    return -1
}

MaxExpand :: (ms: *MatchState, s: s64, p: s64, ep: s64) -> s64 {
    i: s64 = 0
    while SingleMatch(ms, s + i, p, ep) { i += 1 }
    while i >= 0 {
        result := DoMatch(ms, s + i, ep + 1)
        if result >= 0 { return result }
        if ms.failed { return -1 }
        i -= 1
    }
    return -1
}

MinExpand :: (ms: *MatchState, s: s64, p: s64, ep: s64) -> s64 {
    at := s
    while true {
        result := DoMatch(ms, at, ep + 1)
        if result >= 0 { return result }
        if ms.failed { return -1 }
        if SingleMatch(ms, at, p, ep) { at += 1 } else { return -1 }
    }
    return -1
}

StartCapture :: (ms: *MatchState, s: s64, p: s64, what: s64) -> s64 {
    if ms.level >= MAX_CAPTURES { return MatchFail(ms, "too many captures") }
    ms.capture_start[ms.level] = s
    ms.capture_len[ms.level] = what
    ms.level += 1
    result := DoMatch(ms, s, p)
    if result < 0 { ms.level -= 1 }
    return result
}

EndCapture :: (ms: *MatchState, s: s64, p: s64) -> s64 {
    l: s32 = -1
    level := ms.level - 1
    while level >= 0 {
        if ms.capture_len[level] == CAP_UNFINISHED { l = level; break }
        level -= 1
    }
    if l < 0 { return MatchFail(ms, "invalid pattern capture") }
    ms.capture_len[l] = s - ms.capture_start[l]
    result := DoMatch(ms, s, p)
    if result < 0 { ms.capture_len[l] = CAP_UNFINISHED }
    return result
}

MatchCapture :: (ms: *MatchState, s: s64, digit: u8) -> s64 {
    l := cast(s32)(digit - #char "1")
    if l < 0 || l >= ms.level || ms.capture_len[l] == CAP_UNFINISHED { return MatchFail(ms, "invalid capture index") }
    length := ms.capture_len[l]
    if ms.src.count - s >= length {
        start := ms.capture_start[l]
        i: s64 = 0
        while i < length {
            if ms.src[start + i] != ms.src[s + i] { return -1 }
            i += 1
        }
        return s + length
    }
    return -1
}

// Match pattern from p against the subject from s; the end of the match or -1.
DoMatch :: (ms: *MatchState, s_in: s64, p_in: s64) -> s64 {
    ms.depth += 1
    if ms.depth > MAX_MATCH_DEPTH {
        ms.depth -= 1
        return MatchFail(ms, "pattern too complex")
    }
    s := s_in
    p := p_in
    result: s64 = -1
    while true {
        if p >= ms.pat.count { result = s; break }
        pc := ms.pat[p]
        if pc == #char "(" {
            if p + 1 < ms.pat.count && ms.pat[p + 1] == #char ")" {
                result = StartCapture(ms, s, p + 2, CAP_POSITION)
            } else {
                result = StartCapture(ms, s, p + 1, CAP_UNFINISHED)
            }
            break
        }
        if pc == #char ")" {
            result = EndCapture(ms, s, p + 1)
            break
        }
        if pc == #char "$" && p + 1 == ms.pat.count {
            result = ifx s == ms.src.count then s else -1
            break
        }
        if pc == #char "%" && p + 1 < ms.pat.count {
            next := ms.pat[p + 1]
            if next == #char "b" {
                s = MatchBalance(ms, s, p + 2)
                if s >= 0 {
                    p += 4
                    continue
                }
                result = -1
                break
            }
            if next == #char "f" {
                p += 2
                if p >= ms.pat.count || ms.pat[p] != #char "[" {
                    result = MatchFail(ms, "missing '[' after '%f' in pattern")
                    break
                }
                ep := ClassEnd(ms, p)
                if ms.failed { result = -1; break }
                previous: u8 = ifx s == 0 then 0 else ms.src[s - 1]
                current: u8 = ifx s < ms.src.count then ms.src[s] else 0
                if !BracketMatches(ms, previous, p, ep - 1) && BracketMatches(ms, current, p, ep - 1) {
                    p = ep
                    continue
                }
                result = -1
                break
            }
            if IsDigit(next) {
                s = MatchCapture(ms, s, next)
                if s >= 0 {
                    p += 2
                    continue
                }
                result = -1
                break
            }
        }
        // Default: a single-character class with an optional suffix.
        ep := ClassEnd(ms, p)
        if ms.failed { result = -1; break }
        matched := SingleMatch(ms, s, p, ep)
        suffix: u8 = ifx ep < ms.pat.count then ms.pat[ep] else 0
        if suffix == #char "?" {
            if matched {
                r := DoMatch(ms, s + 1, ep + 1)
                if r >= 0 { result = r; break }
                if ms.failed { result = -1; break }
            }
            p = ep + 1
            continue
        }
        if suffix == #char "*" {
            result = MaxExpand(ms, s, p, ep)
            break
        }
        if suffix == #char "+" {
            result = ifx matched then MaxExpand(ms, s + 1, p, ep) else -1
            break
        }
        if suffix == #char "-" {
            result = MinExpand(ms, s, p, ep)
            break
        }
        if !matched { result = -1; break }
        s += 1
        p = ep
    }
    ms.depth -= 1
    return result
}

CaptureValue :: (ms: *MatchState, i: s32, s: s64, e: s64) -> LuaValue {
    L := ms.L
    if i >= ms.level {
        if i == 0 { return StringValue(Intern(L, ms.src[s:e])) }
        MatchFail(ms, "invalid capture index")
        return NilValue()
    }
    length := ms.capture_len[i]
    start := ms.capture_start[i]
    if length == CAP_UNFINISHED {
        MatchFail(ms, "unfinished capture")
        return NilValue()
    }
    if length == CAP_POSITION { return NumberValue(cast(float64)(start + 1)) }
    return StringValue(Intern(L, ms.src[start:start + length]))
}

// Push the captures (or the whole match when there are none).
PushCaptures :: (ms: *MatchState, s: s64, e: s64, whole: bool) -> s32 {
    n := ms.level
    if n == 0 && whole { n = 1 }
    i: s32 = 0
    while i < n {
        v := CaptureValue(ms, i, s, e)
        if ms.failed { return -1 }
        Push(ms.L, v)
        i += 1
    }
    return n
}

HasSpecials :: (pattern: string) -> bool {
    i: s64 = 0
    while i < pattern.count {
        c := pattern[i]
        if c == #char "^" || c == #char "$" || c == #char "*" || c == #char "+" || c == #char "?" || c == #char "." || c == #char "(" || c == #char ")" || c == #char "[" || c == #char "]" || c == #char "%" || c == #char "-" { return true }
        i += 1
    }
    return false
}

PlainFind :: (subject: string, needle: string, from: s64) -> s64 {
    if needle.count == 0 { return from }
    last := subject.count - needle.count
    i := from
    first := needle[0]
    while i <= last {
        if subject[i] == first {
            j: s64 = 1
            while j < needle.count && subject[i + j] == needle[j] { j += 1 }
            if j == needle.count { return i }
        }
        i += 1
    }
    return -1
}

InitMatch :: (ms: *MatchState, L: *LuaState, src: string, pat: string) {
    ms.L = L
    ms.src = src
    ms.pat = pat
    ms.level = 0
    ms.depth = 0
    ms.failed = false
}

FindAux :: (L: *LuaState, find: bool) -> s32 {
    s, ok1 := LuaCheckString(L, 1)
    if !ok1 { return LUA_NATIVE_ERROR }
    p, ok2 := LuaCheckString(L, 2)
    if !ok2 { return LUA_NATIVE_ERROR }
    init, ok3 := LuaOptInteger(L, 3, 1)
    if !ok3 { return LUA_NATIVE_ERROR }
    init = StringPosition(init, s.count) - 1
    if init < 0 { init = 0 }
    if init > s.count { return ReturnNil(L) }
    if find && (Truthy(Arg(L, 4)) || !HasSpecials(p)) {
        position := PlainFind(s, p, init)
        if position < 0 { return ReturnNil(L) }
        Push(L, NumberValue(cast(float64)(position + 1)))
        Push(L, NumberValue(cast(float64)(position + p.count)))
        return 2
    }
    ms: MatchState
    pattern := p
    anchor := pattern.count > 0 && pattern[0] == #char "^"
    if anchor { pattern = pattern[1:] }
    InitMatch(*ms, L, s, pattern)
    at := init
    while true {
        ms.level = 0
        ms.depth = 0
        e := DoMatch(*ms, at, 0)
        if ms.failed { return LUA_NATIVE_ERROR }
        if e >= 0 {
            if find {
                Push(L, NumberValue(cast(float64)(at + 1)))
                Push(L, NumberValue(cast(float64) e))
                n := PushCaptures(*ms, -1, -1, false)
                if n < 0 { return LUA_NATIVE_ERROR }
                return n + 2
            }
            n := PushCaptures(*ms, at, e, true)
            if n < 0 { return LUA_NATIVE_ERROR }
            return n
        }
        at += 1
        if anchor || at > s.count { break }
    }
    return ReturnNil(L)
}

StrFind :: (L: *LuaState) -> s32 { return FindAux(L, true) }
StrMatch :: (L: *LuaState) -> s32 { return FindAux(L, false) }

// gmatch iterator: upvalues subject, pattern, next position.
GmatchStep :: (L: *LuaState) -> s32 {
    sv := IndexValue(L, LuaUpvalueIndex(1))
    pv := IndexValue(L, LuaUpvalueIndex(2))
    position := SafeInteger(IndexValue(L, LuaUpvalueIndex(3)).n)
    s := StrView(L, sv.h)
    p := StrView(L, pv.h)
    ms: MatchState
    InitMatch(*ms, L, s, p)
    at := position
    while at <= s.count {
        ms.level = 0
        ms.depth = 0
        e := DoMatch(*ms, at, 0)
        if ms.failed { return LUA_NATIVE_ERROR }
        if e >= 0 {
            next := e
            if e == at { next = e + 1 }
            SetIndexValue(L, LuaUpvalueIndex(3), NumberValue(cast(float64) next))
            n := PushCaptures(*ms, at, e, true)
            if n < 0 { return LUA_NATIVE_ERROR }
            return n
        }
        at += 1
    }
    return 0
}

StrGmatch :: (L: *LuaState) -> s32 {
    s, ok1 := LuaCheckString(L, 1)
    if !ok1 { return LUA_NATIVE_ERROR }
    p, ok2 := LuaCheckString(L, 2)
    if !ok2 { return LUA_NATIVE_ERROR }
    Push(L, Arg(L, 1))
    Push(L, Arg(L, 2))
    Push(L, NumberValue(0.0))
    LuaPushNativeClosure(L, GmatchStep, 3, "gmatch_iterator")
    return 1
}

// Append the replacement for one match to out.
AddReplacement :: (ms: *MatchState, out: *Vec(u8), s: s64, e: s64, repl: LuaValue) -> bool {
    L := ms.L
    if repl.t == LUA_TSTRING || repl.t == LUA_TNUMBER {
        h, ok := ToStringHandle(L, repl)
        text := StrView(L, h)
        i: s64 = 0
        while i < text.count {
            c := text[i]
            if c == #char "%" && i + 1 < text.count {
                i += 1
                d := text[i]
                if !IsDigit(d) {
                    VecPush(<<out, d)
                } else if d == #char "0" {
                    BuilderAppend(<<out, ms.src[s:e])
                } else {
                    v := CaptureValue(ms, cast(s32)(d - #char "1"), s, e)
                    if ms.failed { return false }
                    if v.t == LUA_TSTRING { BuilderAppend(<<out, StrView(L, v.h)) } else { AppendNumber(out, v.n) }
                }
            } else {
                VecPush(<<out, c)
            }
            i += 1
        }
        return true
    }
    key := CaptureValue(ms, 0, s, e)
    if ms.failed { return false }
    result: LuaValue
    if repl.t == LUA_TTABLE {
        if !GetIndex(L, repl, key, *result, -1) { return false }
    } else {
        th := L.cur
        func := L.threads[th].top
        Push(L, repl)
        n := PushCaptures(ms, s, e, true)
        if n < 0 { return false }
        if !CallValue(L, func, n, 1) { return false }
        result = L.threads[th].stack[func]
        L.threads[th].top = func
    }
    if !Truthy(result) {
        BuilderAppend(<<out, ms.src[s:e])
        return true
    }
    if result.t == LUA_TSTRING {
        BuilderAppend(<<out, StrView(L, result.h))
        return true
    }
    if result.t == LUA_TNUMBER {
        AppendNumber(out, result.n)
        return true
    }
    message: Vec(u8)
    BuilderAppend(message, "invalid replacement value (a ")
    BuilderAppend(message, TypeNameOf(result.t))
    VecPush(message, #char ")")
    LuaErrorText(L, BytesView(*message))
    VecFree(message)
    return false
}

StrGsub :: (L: *LuaState) -> s32 {
    s, ok1 := LuaCheckString(L, 1)
    if !ok1 { return LUA_NATIVE_ERROR }
    p, ok2 := LuaCheckString(L, 2)
    if !ok2 { return LUA_NATIVE_ERROR }
    repl := Arg(L, 3)
    if repl.t != LUA_TNUMBER && repl.t != LUA_TSTRING && repl.t != LUA_TTABLE && repl.t != LUA_TFUNCTION {
        return LuaArgError(L, 3, "string/function/table expected")
    }
    max_n, ok3 := LuaOptInteger(L, 4, s.count + 1)
    if !ok3 { return LUA_NATIVE_ERROR }
    // Keep the subject and pattern alive across replacement callbacks.
    subject_h := Arg(L, 1).h
    pattern := p
    anchor := pattern.count > 0 && pattern[0] == #char "^"
    if anchor { pattern = pattern[1:] }
    ms: MatchState
    InitMatch(*ms, L, s, pattern)
    out: Vec(u8)
    at: s64 = 0
    n: s64 = 0
    while n < max_n {
        ms.level = 0
        ms.depth = 0
        e := DoMatch(*ms, at, 0)
        if ms.failed { VecFree(out); return LUA_NATIVE_ERROR }
        if e >= 0 {
            n += 1
            if !AddReplacement(*ms, *out, at, e, repl) { VecFree(out); return LUA_NATIVE_ERROR }
        }
        if e >= 0 && e > at {
            at = e
        } else if at < s.count {
            VecPush(out, s[at])
            at += 1
        } else {
            break
        }
        if anchor { break }
    }
    if at < s.count { BuilderAppend(out, s[at:]) }
    Push(L, StringValue(InternBytes(L, *out)))
    Push(L, NumberValue(cast(float64) n))
    VecFree(out)
    subject_h = subject_h
    return 2
}

StrLength :: (L: *LuaState) -> s32 {
    s, ok := LuaCheckString(L, 1)
    if !ok { return LUA_NATIVE_ERROR }
    return ReturnValue(L, NumberValue(cast(float64) s.count))
}

StrSub :: (L: *LuaState) -> s32 {
    s, ok := LuaCheckString(L, 1)
    if !ok { return LUA_NATIVE_ERROR }
    i, ok2 := LuaOptInteger(L, 2, 1)
    j, ok3 := LuaOptInteger(L, 3, -1)
    if !ok2 || !ok3 { return LUA_NATIVE_ERROR }
    l := s.count
    start := StringPosition(i, l)
    end := StringPosition(j, l)
    if start < 1 { start = 1 }
    if end > l { end = l }
    if start > end { return ReturnValue(L, StringValue(Intern(L, ""))) }
    if start == 1 && end == l { return ReturnValue(L, Arg(L, 1)) }
    return ReturnValue(L, StringValue(Intern(L, s[start - 1:end])))
}

StrUpper :: (L: *LuaState) -> s32 {
    s, ok := LuaCheckString(L, 1)
    if !ok { return LUA_NATIVE_ERROR }
    out: Vec(u8)
    i: s64 = 0
    while i < s.count {
        c := s[i]
        VecPush(out, ifx IsLowerByte(c) then c - 32 else c)
        i += 1
    }
    Push(L, StringValue(InternBytes(L, *out)))
    VecFree(out)
    return 1
}

StrLower :: (L: *LuaState) -> s32 {
    s, ok := LuaCheckString(L, 1)
    if !ok { return LUA_NATIVE_ERROR }
    out: Vec(u8)
    i: s64 = 0
    while i < s.count {
        c := s[i]
        VecPush(out, ifx IsUpperByte(c) then c + 32 else c)
        i += 1
    }
    Push(L, StringValue(InternBytes(L, *out)))
    VecFree(out)
    return 1
}

StrRep :: (L: *LuaState) -> s32 {
    s, ok := LuaCheckString(L, 1)
    if !ok { return LUA_NATIVE_ERROR }
    n, ok2 := LuaCheckInteger(L, 2)
    if !ok2 { return LUA_NATIVE_ERROR }
    sep, ok3 := LuaOptString(L, 3, "")
    if !ok3 { return LUA_NATIVE_ERROR }
    if n <= 0 { return ReturnValue(L, StringValue(Intern(L, ""))) }
    total := (s.count + sep.count) * n
    if total > 268435456 { return LuaErrorText(L, "resulting string too large") }
    out: Vec(u8)
    VecReserve(out, total)
    i: s64 = 0
    while i < n {
        if i > 0 { BuilderAppend(out, sep) }
        BuilderAppend(out, s)
        i += 1
    }
    Push(L, StringValue(InternBytes(L, *out)))
    VecFree(out)
    return 1
}

StrReverse :: (L: *LuaState) -> s32 {
    s, ok := LuaCheckString(L, 1)
    if !ok { return LUA_NATIVE_ERROR }
    out: Vec(u8)
    i := s.count - 1
    while i >= 0 { VecPush(out, s[i]); i -= 1 }
    Push(L, StringValue(InternBytes(L, *out)))
    VecFree(out)
    return 1
}

StrByte :: (L: *LuaState) -> s32 {
    s, ok := LuaCheckString(L, 1)
    if !ok { return LUA_NATIVE_ERROR }
    i, ok2 := LuaOptInteger(L, 2, 1)
    if !ok2 { return LUA_NATIVE_ERROR }
    j, ok3 := LuaOptInteger(L, 3, i)
    if !ok3 { return LUA_NATIVE_ERROR }
    l := s.count
    start := StringPosition(i, l)
    end := StringPosition(j, l)
    if start < 1 { start = 1 }
    if end > l { end = l }
    if start > end { return 0 }
    n := end - start + 1
    if !EnsureStack(L, Top(L) + n + 1) { return LuaErrorText(L, "string slice too long") }
    k := start
    while k <= end {
        Push(L, NumberValue(cast(float64) s[k - 1]))
        k += 1
    }
    return cast(s32) n
}

StrChar :: (L: *LuaState) -> s32 {
    n := ArgCount(L)
    out: Vec(u8)
    i: s32 = 1
    while i <= n {
        c, ok := LuaCheckInteger(L, i)
        if !ok { VecFree(out); return LUA_NATIVE_ERROR }
        if c < 0 || c > 255 { VecFree(out); return LuaArgError(L, i, "invalid value") }
        VecPush(out, cast(u8) c)
        i += 1
    }
    Push(L, StringValue(InternBytes(L, *out)))
    VecFree(out)
    return 1
}

StrDump :: (L: *LuaState) -> s32 {
    return LuaErrorText(L, "unable to dump given function")
}

AppendQuoted :: (out: *Vec(u8), s: string) {
    VecPush(<<out, #char "\"")
    i: s64 = 0
    while i < s.count {
        c := s[i]
        if c == #char "\"" || c == #char "\\" || c == 10 {
            VecPush(<<out, #char "\\")
            VecPush(<<out, c)
        } else if c == 13 {
            BuilderAppend(<<out, "\\r")
        } else if c == 0 {
            BuilderAppend(<<out, "\\000")
        } else {
            VecPush(<<out, c)
        }
        i += 1
    }
    VecPush(<<out, #char "\"")
}

// Pad body to width: left-justified, or with zeros after any sign/prefix.
AppendPadded :: (out: *Vec(u8), body: *Vec(u8), width: s64, left: bool, zero: bool, prefix_len: s64) {
    pad := width - body.count
    if pad <= 0 {
        BuilderAppend(<<out, BytesView(body))
        return
    }
    if left {
        BuilderAppend(<<out, BytesView(body))
        i: s64 = 0
        while i < pad { VecPush(<<out, #char " "); i += 1 }
        return
    }
    if zero {
        i: s64 = 0
        while i < prefix_len { VecPush(<<out, (<<body)[i]); i += 1 }
        i = 0
        while i < pad { VecPush(<<out, #char "0"); i += 1 }
        i = prefix_len
        while i < body.count { VecPush(<<out, (<<body)[i]); i += 1 }
        return
    }
    i: s64 = 0
    while i < pad { VecPush(<<out, #char " "); i += 1 }
    BuilderAppend(<<out, BytesView(body))
}

AppendUnsigned :: (out: *Vec(u8), value: u64, base: u64, upper: bool) {
    digits := ifx upper then "0123456789ABCDEF" else "0123456789abcdef"
    buffer: [24]u8
    n: s64 = 0
    v := value
    if v == 0 { buffer[0] = #char "0"; n = 1 }
    while v > 0 {
        buffer[n] = digits[cast(s64)(v % base)]
        v /= base
        n += 1
    }
    while n > 0 {
        n -= 1
        VecPush(<<out, buffer[n])
    }
}

NumberToS64 :: (n: float64) -> s64 #inline { return SafeInteger(n) }

// C99 %a: 0x1.hhhp+e, with the shortest exact digits unless a precision is given.
AppendHexFloat :: (out: *Vec(u8), x: float64, upper: bool, precision: s64, alt: bool, plus: bool, space: bool) {
    bits: NumberBits
    bits.f = x
    negative := (bits.u >> 63) != 0
    if x != x {
        BuilderAppend(<<out, ifx upper then "NAN" else "nan")
        return
    }
    if negative { VecPush(<<out, #char "-") } else if plus { VecPush(<<out, #char "+") } else if space { VecPush(<<out, #char " ") }
    if x == Infinity() || x == -Infinity() {
        BuilderAppend(<<out, ifx upper then "INF" else "inf")
        return
    }
    exponent_bits := cast(s64)((bits.u >> 52) & 2047)
    mantissa := bits.u & 0xFFFFFFFFFFFFF
    lead: u64 = 1
    e := exponent_bits - 1023
    if exponent_bits == 0 {
        lead = 0
        e = ifx mantissa == 0 then 0 else -1022
    }
    nibbles: s64 = 13
    if precision >= 0 && precision < 13 {
        drop := cast(u64)((13 - precision) * 4)
        remainder := mantissa & ((cast(u64) 1 << drop) - 1)
        half := cast(u64) 1 << (drop - 1)
        mantissa >>= drop
        if remainder > half || (remainder == half && (mantissa & 1) == 1) { mantissa += 1 }
        if precision == 0 {
            lead += mantissa
            mantissa = 0
        } else if (mantissa >> cast(u64)(precision * 4)) != 0 {
            lead += 1
            mantissa &= (cast(u64) 1 << cast(u64)(precision * 4)) - 1
        }
        nibbles = precision
    } else if precision < 0 {
        while nibbles > 0 && (mantissa & 15) == 0 {
            mantissa >>= 4
            nibbles -= 1
        }
    }
    digits := ifx upper then "0123456789ABCDEF" else "0123456789abcdef"
    BuilderAppend(<<out, ifx upper then "0X" else "0x")
    VecPush(<<out, digits[cast(s64) lead])
    if nibbles > 0 || alt { VecPush(<<out, #char ".") }
    i := nibbles - 1
    while i >= 0 {
        VecPush(<<out, digits[cast(s64)((mantissa >> cast(u64)(i * 4)) & 15)])
        i -= 1
    }
    k := nibbles
    while k < precision { VecPush(<<out, #char "0"); k += 1 }
    VecPush(<<out, ifx upper then #char "P" else #char "p")
    VecPush(<<out, ifx e < 0 then #char "-" else #char "+")
    Append(out, ifx e < 0 then -e else e)
}

StrFormat :: (L: *LuaState) -> s32 {
    format, ok := LuaCheckString(L, 1)
    if !ok { return LUA_NATIVE_ERROR }
    out: Vec(u8)
    body: Vec(u8)
    arg: s32 = 1
    i: s64 = 0
    while i < format.count {
        c := format[i]
        if c != #char "%" {
            VecPush(out, c)
            i += 1
            continue
        }
        i += 1
        if i < format.count && format[i] == #char "%" {
            VecPush(out, #char "%")
            i += 1
            continue
        }
        left := false
        plus := false
        space := false
        alt := false
        zero := false
        while i < format.count {
            f := format[i]
            if f == #char "-" { left = true }
            else if f == #char "+" { plus = true }
            else if f == #char " " { space = true }
            else if f == #char "#" { alt = true }
            else if f == #char "0" { zero = true }
            else { break }
            i += 1
        }
        width: s64 = 0
        digits: s32 = 0
        while i < format.count && IsDigit(format[i]) {
            width = width * 10 + cast(s64)(format[i] - #char "0")
            i += 1
            digits += 1
        }
        precision: s64 = -1
        if i < format.count && format[i] == #char "." {
            i += 1
            precision = 0
            while i < format.count && IsDigit(format[i]) {
                precision = precision * 10 + cast(s64)(format[i] - #char "0")
                i += 1
                digits += 1
            }
        }
        if digits > 4 || i >= format.count {
            VecFree(out)
            VecFree(body)
            return LuaErrorText(L, "invalid format (repeated flags)")
        }
        conv := format[i]
        i += 1
        arg += 1
        VecClear(body)
        prefix: s64 = 0
        if conv == #char "d" || conv == #char "i" {
            n, okn := LuaCheckNumber(L, arg)
            if !okn { VecFree(out); VecFree(body); return LUA_NATIVE_ERROR }
            v := NumberToS64(n)
            if v < 0 { VecPush(body, #char "-"); prefix = 1 }
            else if plus { VecPush(body, #char "+"); prefix = 1 }
            else if space { VecPush(body, #char " "); prefix = 1 }
            magnitude: u64 = ifx v < 0 then cast(u64)(-(v + 1)) + 1 else cast(u64) v
            digits_text: Vec(u8)
            AppendUnsigned(*digits_text, magnitude, 10, false)
            if precision >= 0 {
                k := digits_text.count
                while k < precision { VecPush(body, #char "0"); k += 1 }
                if precision == 0 && magnitude == 0 { VecClear(digits_text) }
            }
            BuilderAppend(body, BytesView(*digits_text))
            VecFree(digits_text)
            AppendPadded(*out, *body, width, left, zero && precision < 0, prefix)
        } else if conv == #char "u" || conv == #char "o" || conv == #char "x" || conv == #char "X" {
            n, okn := LuaCheckNumber(L, arg)
            if !okn { VecFree(out); VecFree(body); return LUA_NATIVE_ERROR }
            v := cast(u64) NumberToS64(n)
            base: u64 = 10
            if conv == #char "o" { base = 8 }
            if conv == #char "x" || conv == #char "X" { base = 16 }
            if alt && base == 16 && v != 0 {
                BuilderAppend(body, ifx conv == #char "x" then "0x" else "0X")
                prefix = 2
            }
            if alt && base == 8 { VecPush(body, #char "0") }
            digits_text: Vec(u8)
            AppendUnsigned(*digits_text, v, base, conv == #char "X")
            if precision >= 0 {
                k := digits_text.count
                while k < precision { VecPush(body, #char "0"); k += 1 }
            }
            BuilderAppend(body, BytesView(*digits_text))
            VecFree(digits_text)
            AppendPadded(*out, *body, width, left, zero && precision < 0, prefix)
        } else if conv == #char "c" {
            n, okn := LuaCheckNumber(L, arg)
            if !okn { VecFree(out); VecFree(body); return LUA_NATIVE_ERROR }
            VecPush(body, cast(u8)(NumberToS64(n) & 255))
            AppendPadded(*out, *body, width, left, false, 0)
        } else if conv == #char "e" || conv == #char "E" || conv == #char "f" || conv == #char "F" || conv == #char "g" || conv == #char "G" {
            n, okn := LuaCheckNumber(L, arg)
            if !okn { VecFree(out); VecFree(body); return LUA_NATIVE_ERROR }
            FormatFloat(*body, n, conv, cast(s32)(ifx precision < 0 then 6 else precision), alt, plus, space)
            if body.count > 0 && (body[0] == #char "-" || body[0] == #char "+" || body[0] == #char " ") { prefix = 1 }
            finite := n == n && n - n == 0.0
            AppendPadded(*out, *body, width, left, zero && finite, prefix)
        } else if conv == #char "a" || conv == #char "A" {
            n, okn := LuaCheckNumber(L, arg)
            if !okn { VecFree(out); VecFree(body); return LUA_NATIVE_ERROR }
            AppendHexFloat(*body, n, conv == #char "A", precision, alt, plus, space)
            if body.count > 0 && (body[0] == #char "-" || body[0] == #char "+" || body[0] == #char " ") { prefix = 1 }
            AppendPadded(*out, *body, width, left, false, prefix)
        } else if conv == #char "q" {
            s, oks := LuaCheckString(L, arg)
            if !oks { VecFree(out); VecFree(body); return LUA_NATIVE_ERROR }
            AppendQuoted(*out, s)
        } else if conv == #char "s" {
            if arg > ArgCount(L) {
                VecFree(out)
                VecFree(body)
                return LuaArgError(L, arg, "no value")
            }
            text: LuaValue
            if !ToStringMeta(L, Arg(L, arg), *text) { VecFree(out); VecFree(body); return LUA_NATIVE_ERROR }
            if text.t == LUA_TSTRING {
                view := StrView(L, text.h)
                if precision >= 0 && precision < view.count { view = view[0:precision] }
                BuilderAppend(body, view)
            } else {
                AppendValueText(L, *body, text)
            }
            AppendPadded(*out, *body, width, left, false, 0)
        } else {
            message: Vec(u8)
            BuilderAppend(message, "invalid option '%")
            VecPush(message, conv)
            BuilderAppend(message, "' to 'format'")
            VecFree(out)
            VecFree(body)
            result := LuaErrorText(L, BytesView(*message))
            VecFree(message)
            return result
        }
    }
    Push(L, StringValue(InternBytes(L, *out)))
    VecFree(out)
    VecFree(body)
    return 1
}

OpenString :: (L: *LuaState) {
    t := NewTable(L, 0, 16)
    RegisterLibrary(L, "string", t)
    SetNative(L, t, "len", StrLength)
    SetNative(L, t, "sub", StrSub)
    SetNative(L, t, "upper", StrUpper)
    SetNative(L, t, "lower", StrLower)
    SetNative(L, t, "rep", StrRep)
    SetNative(L, t, "reverse", StrReverse)
    SetNative(L, t, "byte", StrByte)
    SetNative(L, t, "char", StrChar)
    SetNative(L, t, "format", StrFormat)
    SetNative(L, t, "find", StrFind)
    SetNative(L, t, "match", StrMatch)
    SetNative(L, t, "gmatch", StrGmatch)
    SetNative(L, t, "gfind", StrGmatch)
    SetNative(L, t, "gsub", StrGsub)
    SetNative(L, t, "dump", StrDump)
    meta := NewTable(L, 0, 1)
    SetStr(L, meta, L.tm_names[TM_INDEX], TableValue(t))
    L.type_meta[LUA_TSTRING] = meta
}
