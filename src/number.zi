// Number arithmetic helpers, Lua number parsing and exact printf-style
// decimal formatting (%.14g for tostring, %e/%f/%g for string.format).

#scope_module

TWO52 :: 4503599627370496.0;

Floor :: (x: float64) -> float64 #inline {
    if !(x > -TWO52 && x < TWO52) { return x }
    i := cast(s64) x
    f := cast(float64) i
    if f > x { return f - 1.0 }
    return f
}

Ceil :: (x: float64) -> float64 #inline {
    if !(x > -TWO52 && x < TWO52) { return x }
    i := cast(s64) x
    f := cast(float64) i
    if f < x { return f + 1.0 }
    return f
}

Trunc :: (x: float64) -> float64 #inline {
    if !(x > -TWO52 && x < TWO52) { return x }
    return cast(float64) cast(s64) x
}

// x truncated toward zero as an s64: NaN gives 0, out-of-range values clamp.
// Ziran's float casts trap on those, so all Lua number to integer
// conversions go through here.
SafeInteger :: (x: float64) -> s64 #inline {
    if x >= -9223372036854775808.0 && x < 9223372036854775808.0 { return cast(s64) x }
    if x != x { return 0 }
    if x > 0.0 { return 9223372036854775807 }
    return -9223372036854775807 - 1
}

LuaMod :: (a: float64, b: float64) -> float64 #inline {
    return a - Floor(a / b) * b
}

LuaPow :: (a: float64, b: float64) -> float64 {
    if b == 2.0 { return a * a }
    if b == 0.5 { return Sqrt(a) }
    return Pow(a, b)
}

Fmod :: (a: float64, b: float64) -> float64 {
    if b == 0.0 || a != a || b != b { return NotANumber() }
    if a == Infinity() || a == -Infinity() { return NotANumber() }
    if b == Infinity() || b == -Infinity() { return a }
    // Exact remainder: subtract b scaled by powers of two (each step exact).
    r := ifx a < 0.0 then -a else a
    m := ifx b < 0.0 then -b else b
    if r < m { return a }
    t := m
    while t * 2.0 <= r { t *= 2.0 }
    while t >= m {
        if r >= t { r -= t }
        t /= 2.0
    }
    return ifx a < 0.0 then -r else r
}

IsWhitespaceByte :: (c: u8) -> bool #inline { return c == 32 || (c >= 9 && c <= 13) }

// Parse a Lua numeric literal or tonumber() text (surrounding whitespace
// allowed). Accepts decimal with optional fraction/exponent and 0x hex.
ParseNumberText :: (text: string) -> (value: float64, ok: bool) {
    start: s64 = 0
    end := text.count
    while start < end && IsWhitespaceByte(text[start]) { start += 1 }
    while end > start && IsWhitespaceByte(text[end - 1]) { end -= 1 }
    if start >= end { return 0.0, false }
    negative := false
    at := start
    if text[at] == #char "-" { negative = true; at += 1 }
    else if text[at] == #char "+" { at += 1 }
    if at + 1 < end && text[at] == #char "0" && (text[at + 1] == #char "x" || text[at + 1] == #char "X") {
        at += 2
        if at >= end { return 0.0, false }
        value: float64 = 0.0
        any := false
        while at < end && HexDigitValue(text[at]) >= 0 {
            value = value * 16.0 + cast(float64) HexDigitValue(text[at])
            at += 1
            any = true
        }
        scale: s32 = 0
        if at < end && text[at] == #char "." {
            at += 1
            while at < end && HexDigitValue(text[at]) >= 0 {
                value = value * 16.0 + cast(float64) HexDigitValue(text[at])
                scale -= 4
                at += 1
                any = true
            }
        }
        if !any { return 0.0, false }
        if at < end && (text[at] == #char "p" || text[at] == #char "P") {
            at += 1
            exp_negative := false
            if at < end && (text[at] == #char "+" || text[at] == #char "-") { exp_negative = text[at] == #char "-"; at += 1 }
            if at >= end { return 0.0, false }
            e: s32 = 0
            while at < end && IsDigit(text[at]) {
                if e < 100000 { e = e * 10 + cast(s32)(text[at] - #char "0") }
                at += 1
            }
            scale += ifx exp_negative then -e else e
        }
        if at != end { return 0.0, false }
        if scale != 0 { value = ScaleByPowerOfTwo(value, scale) }
        return ifx negative then -value else value, true
    }
    // Decimal: digits [. digits] [e [sign] digits], at least one digit.
    builder: Vec(u8)
    if negative { VecPush(builder, #char "-") }
    int_digits: s64 = 0
    while at < end && IsDigit(text[at]) { VecPush(builder, text[at]); at += 1; int_digits += 1 }
    if int_digits == 0 { VecPush(builder, #char "0") }
    frac_digits: s64 = 0
    if at < end && text[at] == #char "." {
        at += 1
        VecPush(builder, #char ".")
        while at < end && IsDigit(text[at]) { VecPush(builder, text[at]); at += 1; frac_digits += 1 }
        if frac_digits == 0 { VecPush(builder, #char "0") }
    }
    if int_digits == 0 && frac_digits == 0 { VecFree(builder); return 0.0, false }
    if at < end && (text[at] == #char "e" || text[at] == #char "E") {
        at += 1
        VecPush(builder, #char "e")
        if at < end && (text[at] == #char "+" || text[at] == #char "-") { VecPush(builder, text[at]); at += 1 }
        exp_digits: s64 = 0
        while at < end && IsDigit(text[at]) { VecPush(builder, text[at]); at += 1; exp_digits += 1 }
        if exp_digits == 0 { VecFree(builder); return 0.0, false }
    }
    if at != end { VecFree(builder); return 0.0, false }
    value, ok := ParseFloat64(BytesView(*builder))
    VecFree(builder)
    return value, ok
}

// ---------------------------------------------------------------- bignum

BIG_WORDS :: 90;

Big :: struct {
    words: [90]u32
    count: s32
}

BigSet :: (a: *Big, value: u64) {
    a.count = 0
    v := value
    while v != 0 {
        a.words[a.count] = cast(u32)(v & 0xFFFFFFFF)
        a.count += 1
        v >>= 32
    }
}

BigMulSmall :: (a: *Big, factor: u32) {
    carry: u64 = 0
    i: s32 = 0
    while i < a.count {
        product := cast(u64) a.words[i] * cast(u64) factor + carry
        a.words[i] = cast(u32)(product & 0xFFFFFFFF)
        carry = product >> 32
        i += 1
    }
    if carry != 0 && a.count < BIG_WORDS {
        a.words[a.count] = cast(u32) carry
        a.count += 1
    }
}

BigShiftLeft :: (a: *Big, bits: s32) {
    if a.count == 0 { return }
    words := bits / 32
    rest := bits % 32
    if rest != 0 {
        carry: u32 = 0
        i: s32 = 0
        while i < a.count {
            word := a.words[i]
            a.words[i] = (word << cast(u32) rest) | carry
            carry = word >> cast(u32)(32 - rest)
            i += 1
        }
        if carry != 0 { a.words[a.count] = carry; a.count += 1 }
    }
    if words > 0 {
        i := a.count - 1
        while i >= 0 { a.words[i + words] = a.words[i]; i -= 1 }
        i = 0
        while i < words { a.words[i] = 0; i += 1 }
        a.count += words
    }
}

BigMulPow10 :: (a: *Big, power: s32) {
    p := power
    while p >= 9 { BigMulSmall(a, 1000000000); p -= 9 }
    factor: u32 = 1
    while p > 0 { factor *= 10; p -= 1 }
    if factor != 1 { BigMulSmall(a, factor) }
}

BigCompare :: (a: *Big, b: *Big) -> s32 {
    if a.count != b.count { return ifx a.count < b.count then -1 else 1 }
    i := a.count - 1
    while i >= 0 {
        if a.words[i] != b.words[i] { return ifx a.words[i] < b.words[i] then -1 else 1 }
        i -= 1
    }
    return 0
}

// a -= b, requires a >= b.
BigSub :: (a: *Big, b: *Big) {
    borrow: s64 = 0
    i: s32 = 0
    while i < a.count {
        word := cast(s64) a.words[i] - borrow
        if i < b.count { word -= cast(s64) b.words[i] }
        if word < 0 { word += 4294967296; borrow = 1 } else { borrow = 0 }
        a.words[i] = cast(u32) word
        i += 1
    }
    while a.count > 0 && a.words[a.count - 1] == 0 { a.count -= 1 }
}

// 2*a compared with b.
BigCompareDouble :: (a: *Big, b: *Big) -> s32 {
    doubled := <<a
    BigShiftLeft(*doubled, 1)
    return BigCompare(*doubled, b)
}

// Decimal digits of positive finite x. mode 0: `count` significant digits;
// mode 1: digits through 10^-count (fixed). Writes digits (no leading
// zeros except a lone "0") and returns the decimal exponent of the first
// digit. Rounds half to even on the exact binary value.
DecimalDigits :: (x: float64, mode: s32, count: s32, digits: *Vec(u8)) -> s32 {
    VecClear(<<digits)
    bits: NumberBits
    bits.f = x
    exponent_bits := cast(s32)((bits.u >> 52) & 0x7FF)
    mantissa := bits.u & 0xFFFFFFFFFFFFF
    e: s32
    if exponent_bits == 0 { e = -1074 } else { mantissa |= cast(u64) 1 << 52; e = exponent_bits - 1075 }
    N: Big
    D: Big
    BigSet(*N, mantissa)
    BigSet(*D, 1)
    if e >= 0 { BigShiftLeft(*N, e) } else { BigShiftLeft(*D, -e) }
    // Estimate k = floor(log10 x).
    k := cast(s32) Floor(Log10(x))
    if k >= 0 { BigMulPow10(*D, k) } else { BigMulPow10(*N, -k) }
    // Normalize N/D into [1, 10).
    if BigCompare(*N, *D) < 0 {
        BigMulSmall(*N, 10)
        k -= 1
    } else {
        ten := D
        BigMulSmall(*ten, 10)
        if BigCompare(*N, *ten) >= 0 {
            BigMulSmall(*D, 10)
            k += 1
        }
    }
    wanted: s32 = count
    if mode == 1 { wanted = k + 1 + count }
    if wanted <= 0 {
        // Everything rounds away below the last kept place.
        if wanted == 0 {
            // Value / 10^(k+1) in [0.1, 1): round to 1 unit when > 0.5.
            five := D
            BigMulSmall(*five, 5)
            cmp := BigCompare(*N, *five)
            if cmp > 0 {
                VecPush(<<digits, #char "1")
                return k + 1
            }
        }
        VecPush(<<digits, #char "0")
        return ifx mode == 1 then -count else k
    }
    if wanted > 800 { wanted = 800 }
    i: s32 = 0
    while i < wanted {
        digit: u8 = 0
        while BigCompare(*N, *D) >= 0 { BigSub(*N, *D); digit += 1 }
        VecPush(<<digits, #char "0" + digit)
        BigMulSmall(*N, 10)
        i += 1
    }
    // N now holds remainder * 10; compare remainder with D / 2.
    tenD := D
    BigMulSmall(*tenD, 5)
    cmp := BigCompare(*N, *tenD)
    round_up := cmp > 0 || (cmp == 0 && (((<<digits)[digits.count - 1] - #char "0") & 1) == 1)
    if round_up {
        j := digits.count - 1
        while j >= 0 {
            if (<<digits)[j] == #char "9" {
                (<<digits)[j] = #char "0"
                j -= 1
            } else {
                (<<digits)[j] += 1
                break
            }
        }
        if j < 0 {
            // 99..9 rounded to 100..0.
            VecPush(<<digits, #char "0")
            (<<digits)[0] = #char "1"
            k += 1
            if mode == 0 { VecResize(<<digits, digits.count - 1) }
        }
    }
    return k
}

AppendExponent :: (out: *Vec(u8), exponent: s32, upper: bool) {
    VecPush(<<out, ifx upper then #char "E" else #char "e")
    e := exponent
    if e < 0 { VecPush(<<out, #char "-"); e = -e } else { VecPush(<<out, #char "+") }
    if e < 10 { VecPush(<<out, #char "0") }
    Append(out, cast(s64) e)
}

// Append x formatted like C printf %<conv> with precision (no width/flags
// except alt '#' and forced sign).
FormatFloat :: (out: *Vec(u8), x: float64, conv: u8, precision: s32, alt: bool, plus: bool, space: bool) {
    upper := conv == #char "E" || conv == #char "G" || conv == #char "F"
    if x != x {
        BuilderAppend(<<out, ifx upper then "NAN" else "nan")
        return
    }
    negative := x < 0.0 || IsNegativeZero(x)
    value := ifx negative then -x else x
    if negative { VecPush(<<out, #char "-") }
    else if plus { VecPush(<<out, #char "+") }
    else if space { VecPush(<<out, #char " ") }
    if value == Infinity() {
        BuilderAppend(<<out, ifx upper then "INF" else "inf")
        return
    }
    digits: Vec(u8)
    lower := conv | 32
    if lower == #char "f" {
        if value == 0.0 {
            VecPush(<<out, #char "0")
            if precision > 0 || alt { VecPush(<<out, #char ".") }
            i: s32 = 0
            while i < precision { VecPush(<<out, #char "0"); i += 1 }
            VecFree(digits)
            return
        }
        k := DecimalDigits(value, 1, precision, *digits)
        AppendFixed(out, *digits, k, precision, alt)
        VecFree(digits)
        return
    }
    if lower == #char "e" {
        if value == 0.0 {
            VecPush(<<out, #char "0")
            if precision > 0 || alt { VecPush(<<out, #char ".") }
            i: s32 = 0
            while i < precision { VecPush(<<out, #char "0"); i += 1 }
            AppendExponent(out, 0, upper)
            VecFree(digits)
            return
        }
        k := DecimalDigits(value, 0, precision + 1, *digits)
        VecPush(<<out, digits[0])
        if precision > 0 || alt { VecPush(<<out, #char ".") }
        i: s64 = 1
        while i < digits.count { VecPush(<<out, digits[i]); i += 1 }
        AppendExponent(out, k, upper)
        VecFree(digits)
        return
    }
    // %g
    p := precision
    if p == 0 { p = 1 }
    if value == 0.0 {
        VecPush(<<out, #char "0")
        if alt {
            VecPush(<<out, #char ".")
            i: s32 = 1
            while i < p { VecPush(<<out, #char "0"); i += 1 }
        }
        VecFree(digits)
        return
    }
    k := DecimalDigits(value, 0, p, *digits)
    if !alt {
        // Strip trailing zeros of the significand.
        while digits.count > 1 && digits[digits.count - 1] == #char "0" { VecResize(digits, digits.count - 1) }
    }
    if k < -4 || k >= p {
        VecPush(<<out, digits[0])
        if digits.count > 1 || alt { VecPush(<<out, #char ".") }
        i: s64 = 1
        while i < digits.count { VecPush(<<out, digits[i]); i += 1 }
        if alt {
            while i < p { VecPush(<<out, #char "0"); i += 1 }
        }
        AppendExponent(out, k, upper)
    } else {
        // Fixed notation with p - 1 - k decimals (trailing zeros removed).
        frac := cast(s32)(digits.count) - 1 - k
        if alt { frac = p - 1 - k }
        if frac < 0 { frac = 0 }
        AppendFixed(out, *digits, k, frac, alt)
    }
    VecFree(digits)
}

// Write digits whose first digit has exponent k with `frac` decimals.
AppendFixed :: (out: *Vec(u8), digits: *Vec(u8), k: s32, frac: s32, alt: bool) {
    // Integer part.
    if k < 0 {
        VecPush(<<out, #char "0")
    } else {
        i: s32 = 0
        while i <= k {
            VecPush(<<out, ifx i < digits.count then (<<digits)[i] else #char "0")
            i += 1
        }
    }
    if frac > 0 || alt { VecPush(<<out, #char ".") }
    j: s32 = 0
    while j < frac {
        position := k + 1 + j
        if position < 0 || position >= digits.count {
            VecPush(<<out, #char "0")
        } else {
            VecPush(<<out, (<<digits)[position])
        }
        j += 1
    }
}

// Lua's tostring for numbers: "%.14g".
AppendNumber :: (out: *Vec(u8), x: float64) {
    // %.14g switches to exponent form from 1e14 up.
    if x > -1e14 && x < 1e14 {
        i := cast(s64) x
        if cast(float64) i == x && !(i == 0 && IsNegativeZero(x)) {
            Append(out, i)
            return
        }
    }
    FormatFloat(out, x, #char "g", 14, false, false, false)
}
